    {
      "path": "TabletDriverFilters.Hawku.Smoothing",
      "display_name": "Hawku Smoothing",
      "plugin_name": "HawkuFilters",
      "stage": "pre",
      "advanced": false,
      "best_for": ["smoothing"],
      "summary_key": "engine.filter.hawku_smoothing.summary",
      "added_latency_note": "engine.filter.hawku_smoothing.latency",
      "confidence": "high",
      "sources": [
        "https://github.com/OpenTabletDriver/TabletDriverFilters/blob/master/HawkuFilters/Smoothing.cs",
        "https://github.com/OpenTabletDriver/OpenTabletDriver/blob/v0.6.4.0/OpenTabletDriver.Plugin/Output/AsyncPositionedPipelineElement.cs"
      ],
      "notes": "Exponential smoothing: weight = 1 - 0.37^(1/(Latency/(1000/Frequency))), so the output covers 63% of a step after Latency ms (time constant = Latency). Plugin slider is 0..1000 ms, default 2; its tooltip says below 4 ms you should rather disable it and that ~50 ms is the max for osu!. Frequency (default 1000 Hz) is the filter's own async timer rate inherited from AsyncPositionedPipelineElement, NOT the tablet report rate: this project leaves it at the default.",
      "params": [
        {"name": "Latency", "kind": "float", "default": 2.0, "min": 0.0, "max": 50.0, "step": 0.5, "unit": "ms"},
        {"name": "Frequency", "kind": "float", "default": 1000.0, "min": 30.0, "max": 2000.0, "step": 1.0, "unit": "Hz"}
      ]
    },
    {
      "path": "TabletDriverFilters.Devocub.Antichatter",
      "display_name": "Devocub Antichatter",
      "plugin_name": "HawkuFilters",
      "stage": "pre",
      "advanced": false,
      "best_for": ["chatter", "smoothing", "prediction"],
      "summary_key": "engine.filter.devocub_antichatter.summary",
      "added_latency_note": "engine.filter.devocub_antichatter.latency",
      "confidence": "high",
      "sources": [
        "https://github.com/OpenTabletDriver/TabletDriverFilters/blob/master/DevocubFilters/AntiChatter.cs",
        "https://github.com/OpenTabletDriver/OpenTabletDriver/blob/v0.6.4.0/OpenTabletDriver.Plugin/Output/AsyncPositionedPipelineElement.cs"
      ],
      "notes": "Base weight reaches 90% of a step within Latency ms (time constant ~ Latency/ln 10). Antichatter divides the weight by y(x) = (x + OffsetX)^(-Strength) * Multiplier + OffsetY where x is distance to the target in mm: slow/small moves get much more smoothing, fast moves fall back to the base weight. Tooltip ranges: Strength 1..10, Multiplier 1..1000, OffsetX -1..2, OffsetY -1..10; presets 'Simple' 5-50 ms / Strength 2-3, 'Smooth' ~10 ms / Strength 3 / Multiplier 100. Prediction (cosh curve) wants >= 10-15 ms of latency. Helps tablets without hardware smoothing. Frequency (default 1000 Hz) is the filter's own async timer rate (AsyncPositionedPipelineElement), NOT the tablet report rate; the tooltip says not to change it, so this project leaves it at the default.",
      "params": [
        {"name": "Latency", "kind": "float", "default": 2.0, "min": 0.0, "max": 50.0, "step": 0.5, "unit": "ms"},
        {"name": "AntichatterStrength", "kind": "float", "default": 3.0, "min": 1.0, "max": 10.0, "step": 0.1, "unit": ""},
        {"name": "AntichatterMultiplier", "kind": "float", "default": 1.0, "min": 1.0, "max": 1000.0, "step": 1.0, "unit": ""},
        {"name": "AntichatterOffsetX", "kind": "float", "default": 0.0, "min": -1.0, "max": 2.0, "step": 0.1, "unit": ""},
        {"name": "AntichatterOffsetY", "kind": "float", "default": 1.0, "min": -1.0, "max": 10.0, "step": 0.1, "unit": ""},
        {"name": "PredictionEnabled", "kind": "bool", "default": false, "min": null, "max": null, "step": null, "unit": ""},
        {"name": "PredictionStrength", "kind": "float", "default": 1.1, "min": 0.0, "max": 5.0, "step": 0.1, "unit": ""},
        {"name": "PredictionSharpness", "kind": "float", "default": 1.0, "min": 0.1, "max": 5.0, "step": 0.1, "unit": ""},
        {"name": "PredictionOffsetX", "kind": "float", "default": 3.0, "min": -5.0, "max": 10.0, "step": 0.1, "unit": ""},
        {"name": "PredictionOffsetY", "kind": "float", "default": 0.3, "min": -1.0, "max": 5.0, "step": 0.1, "unit": ""},
        {"name": "Frequency", "kind": "float", "default": 1000.0, "min": 30.0, "max": 2000.0, "step": 1.0, "unit": "Hz"}
      ]
