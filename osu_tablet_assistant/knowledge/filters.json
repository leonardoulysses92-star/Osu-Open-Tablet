        "https://github.com/shmkle/TemporalResampler/blob/main/TemporalResampler/TemporalResampler.cs"
      ],
      "notes": "Runs at PipelinePosition.Raw. Interpolates between reports (Kalman) so a low-rate tablet (e.g. 133 rps) looks fluid on a high-refresh monitor (README example: 240 Hz). frameShift ('Prediction Ratio') 0 = one report interval of latency, 0.5 = half, 1 = none (works best with some smoothing). latency = Hawku-like EMA in ms. followRadius in mm. reverseSmoothing < 1 undoes hardware smoothing and must be tuned per tablet (Reconstructor guide), so it is left at 1. extraFrames ('Maximize Frequency') default true. The report interval is measured from real report timestamps; Frequency is only used in the stats logger, so this project leaves it at the default.",
      "params": [
        {"name": "frameShift", "kind": "float", "default": 0.5, "min": 0.0, "max": 1.0, "step": 0.05, "unit": ""},
        {"name": "followRadius", "kind": "float", "default": 0.0, "min": 0.0, "max": 2.0, "step": 0.01, "unit": "mm"},
        {"name": "latency", "kind": "float", "default": 0.0, "min": 0.0, "max": 50.0, "step": 0.5, "unit": "ms"},
        {"name": "reverseSmoothing", "kind": "float", "default": 1.0, "min": 0.001, "max": 1.0, "step": 0.001, "unit": ""},
        {"name": "extraFrames", "kind": "bool", "default": true, "min": null, "max": null, "step": null, "unit": ""},
        {"name": "loggingEnabled", "kind": "bool", "default": false, "min": null, "max": null, "step": null, "unit": ""},
        {"name": "Frequency", "kind": "float", "default": 1000.0, "min": 30.0, "max": 2000.0, "step": 1.0, "unit": "Hz"}
      ]
