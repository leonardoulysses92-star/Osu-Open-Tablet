      "sources": [
        "https://github.com/hawku/TabletDriver/blob/master/TabletDriverService/TabletFilterNoiseReduction.cpp"
      ],
      "notes": "Path and property names verified in a real OTD 0.6 settings.json. No public source for this exact class was found; behaviour is assumed to follow hawku's noise reduction filter (geometric median of the last N samples, output snaps to the pen once it moves farther than the distance threshold). Defaults are guesses based on hawku's GUI. Latency: only while moving less than DistanceThreshold; fast movement resets the buffer.",
      "params": [
        {"name": "Samples", "kind": "int", "default": 10, "min": 2, "max": 20, "step": 1, "unit": ""},
        {"name": "DistanceThreshold", "kind": "float", "default": 0.5, "min": 0.05, "max": 2.0, "step": 0.05, "unit": "mm"}
      ]
